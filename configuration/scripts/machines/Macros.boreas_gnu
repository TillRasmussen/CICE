#==============================================================================
# Makefile macros for DMI Boreas, gnu compiler
#==============================================================================
# Companion to Macros.boreas_intel.  Flags are the gnu equivalents of the
# intel ones there: -ffp-contract=off for -no-fma, -flto for -ipo.  gfortran
# does not reassociate without -ffast-math, so -fp-model precise needs no
# counterpart.
#==============================================================================

#--- Compiler/preprocessor ---
FC         := ftn
CC         := cc -c
CXX        := cc
CPP        := /usr/bin/cpp
CPPFLAGS   := -P -traditional  # ALLOW fortran double backslash "\\"
SCC   := gcc
SFC   := ftn

CPPDEFS    := -DFORTRANUNDERSCORE ${ICE_CPPDEFS}
CFLAGS     := -c -O2

FFLAGS     := -fconvert=big-endian -fbacktrace -ffree-line-length-none -ffp-contract=off
FFLAGS_NOOPT:= -O0

ifeq ($(ICE_BLDDEBUG), true)
  FFLAGS     += -O0 -g -fcheck=bounds -finit-real=nan -fimplicit-none -ffpe-trap=invalid,zero,overflow
  CFLAGS     += -O0
else
  FFLAGS     += -O3 -finline-functions -flto
endif

# -flto above leaves the objects as IR, so the libcice archive needs gcc-ar.
AR         := gcc-ar

# Linker flags
LD         := $(FC)
LDFLAGS    := $(FFLAGS) -v

# Additional flags
FIXEDFLAGS := -ffixed-line-length-132
FREEFLAGS  := -ffree-form

ifeq ($(ICE_THREADED), true)
   LDFLAGS += -fopenmp
   CFLAGS += -fopenmp
   FFLAGS += -fopenmp
endif

#--- NetCDF ---
ifeq ($(IO_TYPE), netcdf)
   CPPDEFS :=  $(CPPDEFS) -Dncdf
endif

ifeq ($(IO_TYPE), netcdf_bin)
   CPPDEFS :=  $(CPPDEFS) -Dncdf
endif

### if using parallel I/O, load all 3 libraries.  PIO must be first!
ifeq ($(ICE_IOTYPE), pio)
   PIO_PATH:=/usr/projects/climate/SHARED_CLIMATE/software/conejo/pio/1.7.2/intel-13.0.1/openmpi-1.6.3/netcdf-3.6.3-parallel-netcdf-1.3.1/include
   INCLDIR += -I$(PIO_PATH)
   SLIBS   := $(SLIBS) -L$(PIO_PATH) -lpio
endif
